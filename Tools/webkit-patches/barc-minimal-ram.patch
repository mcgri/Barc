+struct BarcRustAdblockState {
+    using NewFromDirFn = void* (*)(const char*, bool);
+    using ShouldBlockFn = bool (*)(const void*, const char*, const char*, const char*);
+
+    void* engine { nullptr };
+    ShouldBlockFn shouldBlock { nullptr };
+
+    BarcRustAdblockState()
+    {
+        if (const char* disabled = std::getenv("BARC_RUST_NETWORK_ADBLOCK"); disabled && disabled[0] == '0')
+            return;
+
+        std::string dylibCandidates[3];
+        size_t candidateCount = 0;
+
+        if (const char* envLib = std::getenv("BARC_RUST_CORE_DYLIB"); envLib && envLib[0])
+            dylibCandidates[candidateCount++] = envLib;
+
+        char execPath[4096];
+        uint32_t execSize = sizeof(execPath);
+        if (_NSGetExecutablePath(execPath, &execSize) == 0) {
+            std::string p(execPath);
+            if (auto pos = p.find("/Contents/Frameworks/WebKit.framework/"); pos != std::string::npos)
+                dylibCandidates[candidateCount++] = p.substr(0, pos) + "/Contents/Frameworks/libbarc_core.dylib";
+        }
+        dylibCandidates[candidateCount++] = "/Volumes/DiskC/browsermigration/Barc/RustCore/target/release/libbarc_core.dylib";
+
+        void* handle = nullptr;
+        for (size_t i = 0; i < candidateCount; ++i) {
+            handle = dlopen(dylibCandidates[i].c_str(), RTLD_LAZY | RTLD_LOCAL);
+            if (handle)
+                break;
+        }
+        if (!handle)
+            return;
+
+        auto newFromDir = reinterpret_cast<NewFromDirFn>(dlsym(handle, "barc_adblock_new_from_dir"));
+        auto blockFn = reinterpret_cast<ShouldBlockFn>(dlsym(handle, "barc_adblock_should_block"));
+        if (!newFromDir || !blockFn)
+            return;
+
+        std::string rulesDir;
+        if (const char* envDir = std::getenv("BARC_ADBLOCK_RULES_DIR"); envDir && envDir[0])
+            rulesDir = envDir;
+        else if (const char* home = std::getenv("HOME"); home && home[0])
+            rulesDir = std::string(home) + "/Library/Application Support/io.github.mcgri.Barc/filter-lists";
+
+        if (rulesDir.empty())
+            return;
+
+        engine = newFromDir(rulesDir.c_str(), false);
+        if (engine)
+            shouldBlock = blockFn;
+    }
+};
+
+static const char* barcResourceTypeForDestination(WebCore::FetchOptions::Destination destination)
+{
+    switch (destination) {
+    case WebCore::FetchOptions::Destination::Script:
+    case WebCore::FetchOptions::Destination::Worker:
+    case WebCore::FetchOptions::Destination::Sharedworker:
+    case WebCore::FetchOptions::Destination::Serviceworker:
+    case WebCore::FetchOptions::Destination::Audioworklet:
+    case WebCore::FetchOptions::Destination::Paintworklet:
+        return "script";
+    case WebCore::FetchOptions::Destination::Image:
+        return "image";
+    case WebCore::FetchOptions::Destination::Style:
+        return "stylesheet";
+    case WebCore::FetchOptions::Destination::Iframe:
+    case WebCore::FetchOptions::Destination::Document:
+        return "sub_frame";
+    case WebCore::FetchOptions::Destination::Font:
+        return "font";
+    case WebCore::FetchOptions::Destination::Audio:
+    case WebCore::FetchOptions::Destination::Video:
+    case WebCore::FetchOptions::Destination::Track:
+        return "media";
+    case WebCore::FetchOptions::Destination::Object:
+    case WebCore::FetchOptions::Destination::Embed:
+        return "object";
+    case WebCore::FetchOptions::Destination::EmptyString:
+    case WebCore::FetchOptions::Destination::Json:
+    case WebCore::FetchOptions::Destination::Text:
+        return "xmlhttprequest";
+    default:
+        return "other";
+    }
+}
+
+static bool barcRustAdblockShouldBlock(const URL& requestURL, const URL& mainDocumentURL, WebCore::FetchOptions::Destination destination)
+{
+    static BarcRustAdblockState state;
+    if (!state.engine || !state.shouldBlock)
+        return false;
+    auto urlUTF8 = requestURL.string().utf8();
+    auto docUTF8 = mainDocumentURL.string().utf8();
+    return state.shouldBlock(
+        state.engine,
+        reinterpret_cast<const char*>(urlUTF8.data()),
+        reinterpret_cast<const char*>(docUTF8.data()),
+        barcResourceTypeForDestination(destination));
+}
