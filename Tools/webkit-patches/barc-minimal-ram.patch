 void MemoryCache::setCapacities(unsigned minDeadBytes, unsigned maxDeadBytes, unsigned totalBytes)
 {
+    // Barc minimal-RAM tuning: cap per-WebContent MemoryCache so each process
+    // holds at most 16 MB total / 4 MB dead decoded images and scripts.
+    constexpr unsigned barcMaxTotal = 16 * 1024 * 1024;
+    constexpr unsigned barcMaxDead = 4 * 1024 * 1024;
+    totalBytes = std::min(totalBytes, barcMaxTotal);
+    maxDeadBytes = std::min(maxDeadBytes, std::min(barcMaxDead, totalBytes));
+    minDeadBytes = std::min(minDeadBytes, maxDeadBytes);
     ASSERT(minDeadBytes <= maxDeadBytes);
     ASSERT(maxDeadBytes <= totalBytes);
     m_minDeadCapacity = minDeadBytes;
