#!/bin/sh
# Modified for Barc: application identity, branding and fork configuration, 2026-10-23.
# The Barc command-line tool. Ships inside the app bundle as
# Contents/Resources/barc-cli; link it somewhere on your PATH:
#   ln -s /Applications/Barc.app/Contents/Resources/barc-cli /usr/local/bin/barc
#
#   barc open URL [--space NAME] [--background]   open a page
#   barc space NAME                               switch to a Space
#   barc command ID                               run a palette command (e.g. print-page)
#   barc new-tab                                  open a new tab
#   barc url ...                                  print the barc:// address instead of opening it
set -e

encode() {
    printf '%s' "$1" | xxd -p | tr -d '\n' | sed 's/../%&/g'
}

usage() {
    sed -n '3,10p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
}

print_only=0
if [ "${1-}" = "url" ]; then print_only=1; shift; fi
[ $# -ge 1 ] || usage

case "$1" in
    open)
        [ $# -ge 2 ] || usage
        target="barc://tab?url=$(encode "$2")"
        shift 2
        while [ $# -gt 0 ]; do
            case "$1" in
                --space) target="$target&space=$(encode "$2")"; shift 2 ;;
                --background|-g) target="$target&background=1"; shift ;;
                *) usage ;;
            esac
        done
        ;;
    space)   [ $# -eq 2 ] || usage; target="barc://space?name=$(encode "$2")" ;;
    command) [ $# -eq 2 ] || usage; target="barc://command?id=$(encode "$2")" ;;
    new-tab) target="barc://new-tab" ;;
    *) usage ;;
esac

if [ $print_only -eq 1 ]; then
    printf '%s\n' "$target"
else
    open -a Barc "$target"
fi
